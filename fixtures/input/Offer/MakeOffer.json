{
  "cases": [
    {
      "label": "minimal input (required fields only)",
      "input": {
        "itemId": "mock-item-id",
        "proposedPrice": {
          "currency": "USD",
          "value": "19.99"
        }
      },
      "expected": {
        "itemId": "mock-item-id",
        "proposedPrice": {
          "currency": "USD",
          "value": "19.99"
        }
      }
    },
    {
      "label": "null optionals are stripped",
      "input": {
        "itemId": "mock-item-id",
        "proposedPrice": {
          "currency": "USD",
          "value": "19.99"
        },
        "quantity": null,
        "message": null
      },
      "expected": {
        "itemId": "mock-item-id",
        "proposedPrice": {
          "currency": "USD",
          "value": "19.99"
        }
      }
    },
    {
      "label": "all fields filled in",
      "input": {
        "itemId": "mock-item-id",
        "proposedPrice": {
          "currency": "GBP",
          "value": "35.00"
        },
        "quantity": 3,
        "message": "I'd like to buy 3, please!"
      },
      "expected": {
        "itemId": "mock-item-id",
        "proposedPrice": {
          "currency": "GBP",
          "value": "35.00"
        },
        "quantity": 3,
        "message": "I'd like to buy 3, please!"
      }
    }
  ]
}
