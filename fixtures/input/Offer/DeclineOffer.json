{
  "cases": [
    {
      "label": "minimal input (no message)",
      "input": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id"
      },
      "expected": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id"
      }
    },
    {
      "label": "null message is stripped",
      "input": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id",
        "message": null
      },
      "expected": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id"
      }
    },
    {
      "label": "with decline reason message",
      "input": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id",
        "message": "Price is too low, sorry."
      },
      "expected": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id",
        "message": "Price is too low, sorry."
      }
    }
  ]
}
