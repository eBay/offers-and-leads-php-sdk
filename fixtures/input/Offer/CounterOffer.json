{
  "cases": [
    {
      "label": "minimal input (required fields only)",
      "input": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id",
        "proposedPrice": {
          "currency": "USD",
          "value": "25.00"
        }
      },
      "expected": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id",
        "proposedPrice": {
          "currency": "USD",
          "value": "25.00"
        }
      }
    },
    {
      "label": "null optionals are stripped",
      "input": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id",
        "proposedPrice": {
          "currency": "USD",
          "value": "25.00"
        },
        "quantity": null,
        "message": null
      },
      "expected": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id",
        "proposedPrice": {
          "currency": "USD",
          "value": "25.00"
        }
      }
    },
    {
      "label": "all fields filled in",
      "input": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id",
        "proposedPrice": {
          "currency": "AED",
          "value": "50.00"
        },
        "quantity": 2,
        "message": "How about this price?"
      },
      "expected": {
        "itemId": "mock-item-id",
        "offerId": "mock-offer-id",
        "proposedPrice": {
          "currency": "AED",
          "value": "50.00"
        },
        "quantity": 2,
        "message": "How about this price?"
      }
    }
  ]
}
