{
  "cases": [
    {
      "label": "empty input",
      "input": {},
      "expected": {}
    },
    {
      "label": "filters with all null fields serialises as object",
      "input": {
        "filters": {
          "activeAfter": null,
          "activeBefore": null,
          "negotiationCreatorRole": null,
          "statusFilter": null
        }
      },
      "expected": {
        "filters": {}
      }
    },
    {
      "label": "filters with date range and status",
      "input": {
        "filters": {
          "activeAfter": "2024-01-01T00:00:00.000Z",
          "activeBefore": "2027-01-01T00:00:00.000Z",
          "negotiationCreatorRole": "BUYER",
          "statusFilter": "ACTIONABLE"
        }
      },
      "expected": {
        "filters": {
          "activeAfter": "2024-01-01T00:00:00.000Z",
          "activeBefore": "2027-01-01T00:00:00.000Z",
          "negotiationCreatorRole": "BUYER",
          "statusFilter": "ACTIONABLE"
        }
      }
    },
    {
      "label": "filters with pagination (pageCursor null is stripped)",
      "input": {
        "filters": {
          "statusFilter": "ALL",
          "pagination": {
            "maxPageSize": 10,
            "pageCursor": null
          }
        }
      },
      "expected": {
        "filters": {
          "statusFilter": "ALL",
          "pagination": {
            "maxPageSize": 10
          }
        }
      }
    }
  ]
}
