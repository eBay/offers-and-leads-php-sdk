{
    "name": "ebay/offers-and-leads-php-sdk",
    "version": "0.1.0",
    "description": "OffersAndLeads PHP SDK",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "microsoft/kiota-abstractions": "^2.0",
        "microsoft/kiota-http-guzzle": "^2.0",
        "microsoft/kiota-serialization-json": "^2.0",
        "microsoft/kiota-serialization-form": "^2.0",
        "microsoft/kiota-serialization-multipart": "^2.0",
        "microsoft/kiota-serialization-text": "^2.0",
        "guzzlehttp/guzzle": "^7.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.0",
        "dominikb/composer-license-checker": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "EBay\\OffersAndLeads\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EBay\\OffersAndLeads\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
